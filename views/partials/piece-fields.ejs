<div class="form-grid">
  <div class="form-field">
    <label for="type">Type de pièce</label>
    <select id="type" name="type" required>
      <% Object.keys(typesPieces).forEach(function (key) { %>
        <option value="<%= key %>"><%= typesPieces[key] %></option>
      <% }); %>
    </select>
  </div>
  <div class="form-field">
    <label for="fichier">Fichier (PDF ou JPG, 5 Mo maximum)</label>
    <input id="fichier" type="file" name="fichier" accept="application/pdf,image/jpeg" required>
  </div>
</div>
<div class="form-actions">
  <button class="btn btn-outline" type="reset">Réinitialiser</button>
  <button class="btn btn-primary" type="submit">Déposer la pièce</button>
</div>
