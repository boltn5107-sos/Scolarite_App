<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<main class="content">
  <%- include('../partials/flash') %>
  <div class="breadcrumb">Accueil / Scolarité / <strong>Attestations</strong></div>
  <div class="page-heading">
    <div>
      <h1 class="page-title">Mes attestations d'inscription</h1>
      <p class="page-subtitle"><%= dossiers.length %> attestation<%= dossiers.length > 1 ? 's' : '' %> disponible<%= dossiers.length > 1 ? 's' : '' %> · dossiers validés uniquement</p>
    </div>
  </div>

  <div class="doc-grid">
    <% if (!dossiers.length) { %>
      <div class="doc-empty">Aucune attestation disponible pour le moment.</div>
    <% } %>
    <% dossiers.forEach(function (dossier) { %>
      <%
        const document = {
          id: dossier.id,
          dossier_id: dossier.id,
          nom_fichier: 'attestation-' + (dossier.numero_etudiant || dossier.id) + '.pdf',
          type: 'attestation',
          taille: null,
          created_at: dossier.updated_at
        };
      %>
      <%- include('../partials/document-card', {
        piece: document,
        types,
        label: 'Attestation d’inscription',
        status: dossier.etat,
        dossierUrl: '/etudiant/dossier/' + dossier.id,
        downloadUrl: '/etudiant/dossier/' + dossier.id + '/attestation'
      }) %>
    <% }); %>
  </div>
</main>
</body>
</html>
