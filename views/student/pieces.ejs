<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>
<main class="content">
  <%- include('../partials/flash') %>
  <div class="breadcrumb">Accueil / Scolarité / <strong>Mes pièces</strong></div>
  <div class="page-heading">
    <div>
      <h1 class="page-title">Mes pièces justificatives</h1>
      <p class="page-subtitle"><%= pieces.length %> document<%= pieces.length > 1 ? 's' : '' %> déposé<%= pieces.length > 1 ? 's' : '' %> · PDF ou JPG · 5 Mo maximum par fichier</p>
    </div>
    <a class="btn btn-primary" href="/etudiant/piece/nouveau"><%- icon('plus') %> Déposer une pièce</a>
  </div>

  <div class="doc-grid">
    <% if (!pieces.length) { %>
      <div class="doc-empty"><%- icon('file') %><br>Aucune pièce déposée. Utilisez le bouton « Déposer une pièce ».</div>
    <% } %>
    <% pieces.forEach(function (piece) { %>
      <%- include('../partials/document-card', {
        piece,
        types,
        downloadUrl: '/etudiant/piece/' + piece.id + '/download',
        dossierUrl: '/etudiant/dossier/' + piece.dossier_id
      }) %>
    <% }); %>
  </div>
</main>
</body>
</html>
